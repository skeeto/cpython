/* pyconfig.h for the w64devkit (mingw-w64 GCC, msvcrt.dll) build of CPython.

   Generated by Platforms/w64devkit/cmake/PyConfig.cmake from
   Platforms/w64devkit/templates/pyconfig.h.in.  Do not edit.

   The body is PC/pyconfig.h verbatim, with its own Py_CONFIG_H guard, so
   that sources which quote-include "pyconfig.h" from PC/ (PC/winsound.c)
   still end up with the overlay below.  The overlay corrects the values
   PC/pyconfig.h gets wrong for GCC. */
#ifndef Py_W64DEVKIT_PYCONFIG_H
#define Py_W64DEVKIT_PYCONFIG_H

#if !defined(__MINGW32__)
#  error "These headers are for the w64devkit build of CPython (mingw-w64)."
#endif
#if (@PY_SIZEOF_VOID_P@ == 8) != defined(_WIN64)
#  error "These headers are for a @PY_ARCH_BITS@-bit CPython."
#endif

@PY_DEBUG_DEFINE@

/* ---- PC/pyconfig.h ---------------------------------------------------- */
@PY_PC_PYCONFIG_H@
/* ---- end of PC/pyconfig.h --------------------------------------------- */

/* GCC's types differ from MSVC's. */
#undef SIZEOF_TIME_T
#define SIZEOF_TIME_T 8
#undef ALIGNOF_MAX_ALIGN_T
#define ALIGNOF_MAX_ALIGN_T 16
#undef SIZEOF_PID_T
#ifdef _WIN64
#  define SIZEOF_PID_T 8
#else
#  define SIZEOF_PID_T 4
#endif

/* msvcrt.dll has wcsftime(), PC/pyconfig.h only checks for MSVC. */
#ifndef HAVE_WCSFTIME
#  define HAVE_WCSFTIME 1
#endif

#ifndef HAVE_COMPUTED_GOTOS
#  define HAVE_COMPUTED_GOTOS 1
#endif

/* PC/pyconfig.h defines Py_ssize_t only for MSVC, so pyport.h tests
   HAVE_SSIZE_T, an error under -Werror=undef if undefined.  mingw-w64's
   ssize_t is intptr_t, Py_ssize_t's type without it. */
#ifndef HAVE_SSIZE_T
#  define HAVE_SSIZE_T 1
#endif

#undef PY_SUPPORT_TIER
#define PY_SUPPORT_TIER 0

#undef _Py_COMPILER
#ifdef _WIN64
#  define _Py_COMPILER "[GCC " __VERSION__ " 64 bit (AMD64) msvcrt]"
#else
#  define _Py_COMPILER "[GCC " __VERSION__ " 32 bit (Intel) msvcrt]"
#endif

/* Extension module suffix (.cp315-<tag>.pyd) and sysconfig.get_platform(). */
#undef PYD_PLATFORM_TAG
#define PYD_PLATFORM_TAG "@PY_PLATFORM_TAG@"

/* python.dll and libpython.a use msvcrt.dll. */
#if defined(Py_NO_ENABLE_SHARED) && defined(_UCRT)
#  error "libpython.a uses msvcrt.dll and cannot be linked into a UCRT program."
#endif

@PY_XP_DEFINES@

#if defined(Py_BUILD_CORE) || defined(Py_BUILD_CORE_BUILTIN) || defined(Py_BUILD_CORE_MODULE)
#  if defined(__clang__) || !defined(__GNUC__)
#    error "CPython's w64devkit build must be compiled with mingw-w64 GCC."
#  endif
#  if !defined(_WIN32_WINNT) || _WIN32_WINNT < 0x0A00
#    error "Compile CPython with -D_WIN32_WINNT=0x0A00 -DWINVER=0x0A00 on the command line."
#  endif
   /* The whole standard library is frozen into the binary. */
#  define Py_STDLIB_FROZEN 1
#  ifndef MS_DLL_ID
#    define MS_DLL_ID "@PY_MS_DLL_ID@"
#  endif
   /* Name of the runtime DLL that extension modules must import
      (Python/dynload_win.c).  The static runtime cannot share its API
      with a DLL, so like WASI it has no dynamic loading at all:
      importlib.machinery.EXTENSION_SUFFIXES is empty. */
#  ifdef Py_ENABLE_SHARED
#    define PY_DLL_NAME "@PY_DLL_NAME@"
#  else
#    undef HAVE_DYNAMIC_LOADING
#  endif
#  ifndef Py_REMOTE_DEBUG
#    define Py_REMOTE_DEBUG 1
#  endif
#endif

#endif /* Py_W64DEVKIT_PYCONFIG_H */
