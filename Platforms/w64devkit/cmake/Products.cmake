# python.exe, pythonw.exe, python.dll and libpython.a.

# Dependency OBJECT libraries used by the core or by modules.
get_property(PY_DEP_TARGETS GLOBAL PROPERTY PY_DEP_TARGETS)
list(REMOVE_DUPLICATES PY_DEP_TARGETS)

set(PY_SYSTEM_LIBS ${PY_CORE_SYSTEM_LIBS} ${PY_EXTENSION_LIBS})
foreach(_t IN LISTS PY_DEP_TARGETS)
  get_target_property(_libs ${_t} PY_SYSTEM_LIBS)
  if(_libs)
    list(APPEND PY_SYSTEM_LIBS ${_libs})
  endif()
endforeach()
list(REMOVE_DUPLICATES PY_SYSTEM_LIBS)

# Objects shared by both runtimes: modules, config.c, frozen data, deps.
set(PY_NEUTRAL_OBJECTS
  $<TARGET_OBJECTS:py_config>
  $<TARGET_OBJECTS:py_frozen_data>)
foreach(_t IN LISTS PY_EXTENSION_TARGETS PY_DEP_TARGETS)
  list(APPEND PY_NEUTRAL_OBJECTS $<TARGET_OBJECTS:${_t}>)
endforeach()

# Windows XP (Core.cmake).
if(PY_TARGET_XP)
  list(APPEND PY_NEUTRAL_OBJECTS $<TARGET_OBJECTS:py_xpcompat>)
endif()

# All objects of one runtime flavor.
function(py_runtime_objects flavor out)
  set(${out}
    $<TARGET_OBJECTS:py_core_${flavor}>
    $<TARGET_OBJECTS:py_late_${flavor}>
    ${PY_NEUTRAL_OBJECTS}
    PARENT_SCOPE)
endfunction()

# ---- version resources ------------------------------------------------------

# FIELD3 as PCbuild/python.props computes it.
math(EXPR PY_RC_FIELD3 "${PY_MICRO} * 1000 + ${PY_RELEASE_LEVEL} * 10 + ${PY_RELEASE_SERIAL}")

# py_resource(<out var> <stock .rc> <original filename>)
function(py_resource out rc filename)
  get_filename_component(_base "${rc}" NAME_WE)
  set(_wrapper "${PY_GEN}/rc/${_base}.rc")
  py_write_header("${_wrapper}" "\
/* Generated by Products.cmake */
#define FIELD3 ${PY_RC_FIELD3}
#define ORIGINAL_FILENAME \"${filename}\"
#include \"${rc}\"
")
  set(${out} "${_wrapper}" PARENT_SCOPE)
endfunction()

set(CMAKE_RC_FLAGS "${CMAKE_RC_FLAGS} -c 1252")
function(py_resource_flags target)
  # windres finds the icon and manifest relative to these directories.
  target_include_directories(${target} PRIVATE "${PY_SRC}/PC" "${PY_SRC}/Include")
  if(PY_DEBUG)
    target_compile_definitions(${target} PRIVATE "$<$<COMPILE_LANGUAGE:RC>:Py_DEBUG;_DEBUG>")
  endif()
endfunction()

# Copy a product into the build-tree run directory <build>/run/<flavor>
# (see the end of this file).
#
# Besides pybuilddir.txt, it gets what makes it a build tree to sysconfig
# and setuptools, as PCbuild's output directory is: Modules/Setup.local
# makes sysconfig.is_python_build() true (venv then takes its launchers
# from the program's directory), PC/pyconfig.h is get_config_h_filename(),
# and pyconfig.h beside the program is the platform include directory.
function(py_run_copy flavor target)
  set(_dir "${PY_RUN}/${flavor}")
  add_custom_command(TARGET ${target} POST_BUILD
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${_dir}/Modules" "${_dir}/PC"
    COMMAND "${CMAKE_COMMAND}" -E touch "${_dir}/pybuilddir.txt" "${_dir}/Modules/Setup.local"
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${PY_GEN}/include/pyconfig.h" "${_dir}"
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${PY_GEN}/include/pyconfig.h" "${_dir}/PC"
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:${target}>" "${_dir}"
    VERBATIM)
endfunction()

# ---- python.dll and python.dll.a --------------------------------------------
#
# Exports exactly the PyAPI_FUNC/PyAPI_DATA declarations (dllexport in the
# shared flavor); nothing is exported automatically.

if(PY_BUILD_SHARED)
  py_runtime_objects(shared _objs)
  py_resource(_rc "${PY_SRC}/PC/python_nt.rc" "${PY_DLL_NAME}")
  add_library(py_dll SHARED "${_rc}" ${_objs})
  set_target_properties(py_dll PROPERTIES
    OUTPUT_NAME "${PY_BASENAME}${PY_DEBUG_EXT}"
    PREFIX ""
    IMPORT_PREFIX ""
    IMPORT_SUFFIX ".dll.a"
    LINKER_LANGUAGE C
    RUNTIME_OUTPUT_DIRECTORY "${PY_OUT_BIN}"
    ARCHIVE_OUTPUT_DIRECTORY "${PY_OUT_LIB}")
  py_resource_flags(py_dll)
  target_link_libraries(py_dll PRIVATE ${PY_SYSTEM_LIBS})
  target_link_options(py_dll PRIVATE -Wl,--exclude-all-symbols)
  # Consumers: the DLL's import library and its ABI.
  target_include_directories(py_dll INTERFACE "${PY_GEN}/include" "${PY_SRC}/Include")
endif()

# ---- libpython.a ------------------------------------------------------------
#
# Prelinked (PY_STATIC_PRELINK, scripts/prelink.cmake): one object whose
# only global symbols are the Python API.  Otherwise a plain archive of the
# static flavor's objects, with every internal symbol visible.

if(PY_BUILD_STATIC OR (PY_BUILD_EXE AND PY_EXE_LINK STREQUAL "STATIC"))
  py_runtime_objects(static _objs)
  set(PY_STATIC_LIB "${PY_OUT_LIB}/lib${PY_BASENAME}${PY_DEBUG_EXT}.a")
  if(PY_STATIC_PRELINK)
    set(_work "${PY_BIN}/prelink")
    set(_rsp "${_work}/objects.rsp")
    # The API exports of the static python.exe (src/static_exports.h).
    set(PY_STATIC_DEF "${_work}/python.def")
    file(GENERATE OUTPUT "${_rsp}" CONTENT "\"$<JOIN:${_objs},\"
\">\"
")
    add_custom_command(
      OUTPUT "${PY_STATIC_LIB}" "${PY_STATIC_DEF}"
      COMMAND "${CMAKE_COMMAND}"
              "-DCC=${CMAKE_C_COMPILER}" "-DNM=${CMAKE_NM}" "-DOBJCOPY=${CMAKE_OBJCOPY}"
              "-DOBJDUMP=${CMAKE_OBJDUMP}" "-DAR=${CMAKE_AR}" "-DRSP=${_rsp}"
              "-DWORK=${_work}" "-DOUT=${PY_STATIC_LIB}" "-DU=${PY_SYM_PREFIX}"
              "-DSHIM=${PY_STATIC_IMP_SHIM}" "-DDEF=${PY_STATIC_DEF}"
              -P "${PY_W64}/cmake/scripts/prelink.cmake"
      DEPENDS ${_objs} "${_rsp}" "${PY_W64}/cmake/scripts/prelink.cmake"
      COMMENT "Prelinking lib${PY_BASENAME}${PY_DEBUG_EXT}.a"
      VERBATIM)
    add_custom_target(py_static_lib ALL DEPENDS "${PY_STATIC_LIB}")
    add_library(py_static STATIC IMPORTED GLOBAL)
    set_target_properties(py_static PROPERTIES IMPORTED_LOCATION "${PY_STATIC_LIB}")
    add_dependencies(py_static py_static_lib)
  else()
    add_library(py_static STATIC ${_objs})
    set_target_properties(py_static PROPERTIES
      OUTPUT_NAME "${PY_BASENAME}${PY_DEBUG_EXT}"
      LINKER_LANGUAGE C
      ARCHIVE_OUTPUT_DIRECTORY "${PY_OUT_LIB}")
  endif()
  target_link_libraries(py_static INTERFACE ${PY_SYSTEM_LIBS})
  target_compile_definitions(py_static INTERFACE Py_NO_ENABLE_SHARED)
  target_include_directories(py_static INTERFACE "${PY_GEN}/include" "${PY_SRC}/Include")
endif()

# ---- python.exe and pythonw.exe ---------------------------------------------

if(PY_DEBUG)
  set(PY_EXE_STACK 12000000)
else()
  set(PY_EXE_STACK 2000000)
endif()

# py_program(<target> <main.c> <stock .rc> <gui suffix> <flavor> <output dir>)
# FLAVOR static links libpython.a, shared links python.dll.  The program
# is compiled as an API consumer, from the library's usage requirements.
function(py_program target main rc gui flavor outdir)
  py_resource(_rc "${PY_SRC}/PC/${rc}" "${PY_BASENAME}${gui}${PY_DEBUG_EXT}.exe")
  add_executable(${target} "${main}" "${_rc}")
  set_target_properties(${target} PROPERTIES
    OUTPUT_NAME "${PY_BASENAME}${gui}${PY_DEBUG_EXT}"
    RUNTIME_OUTPUT_DIRECTORY "${outdir}")
  py_resource_flags(${target})
  target_link_options(${target} PRIVATE -municode "-Wl,--stack,${PY_EXE_STACK}")
  if(NOT gui STREQUAL "")
    target_link_options(${target} PRIVATE -mwindows)
  endif()
  if(PY_ARCH STREQUAL "x86")
    target_link_options(${target} PRIVATE -Wl,--large-address-aware)
  endif()
  if(flavor STREQUAL "static")
    target_link_libraries(${target} PRIVATE py_static)
    if(PY_STATIC_PRELINK)
      # Export the API, as python.dll does, for ctypes.pythonapi.
      target_link_options(${target} PRIVATE "${PY_STATIC_DEF}")
      set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${PY_STATIC_DEF}")
    endif()
    # An exe with exports gets an import library; keep it out of lib/.
    set_target_properties(${target} PROPERTIES
      ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/${target}.dir")
  else()
    target_link_libraries(${target} PRIVATE py_dll)
  endif()
  # With PY_BUILD_TEST_MODULES, run/static/python.exe is the test variant
  # from TestModules.cmake instead.
  if(NOT (flavor STREQUAL "static" AND PY_BUILD_TEST_MODULES))
    py_run_copy(${flavor} ${target})
  endif()
endfunction()

string(TOLOWER "${PY_EXE_LINK}" PY_EXE_FLAVOR)
if(PY_BUILD_EXE)
  py_program(python "${PY_SRC}/Programs/python.c" python_exe.rc "" ${PY_EXE_FLAVOR} "${PY_OUT_BIN}")
  if(PY_BUILD_PYTHONW)
    py_program(pythonw "${PY_SRC}/PC/WinMain.c" pythonw_exe.rc w ${PY_EXE_FLAVOR} "${PY_OUT_BIN}")
  endif()
endif()
if(PY_BUILD_SHARED)
  py_run_copy(shared py_dll)
  # Extension modules built from the run directory link this.
  add_custom_command(TARGET py_dll POST_BUILD
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different
            "$<TARGET_LINKER_FILE:py_dll>" "${PY_RUN}/shared"
    VERBATIM)
endif()

# ---- venv launchers ---------------------------------------------------------
#
# venv copies these into each environment as Scripts\python[w].exe; they
# read pyvenv.cfg's home and run <home>\python[w].exe.  venv looks for them
# in <stdlib dir>\venv\scripts\nt, or in the program's directory in a build
# tree (Lib/venv/__init__.py).  PathCch needs Windows 8, as python.org's do.

if(PY_BUILD_EXE AND NOT PY_TARGET_XP)
  set(PY_VENV_LAUNCHERS)
  foreach(_v IN ITEMS venvlauncher venvwlauncher)
    if(_v STREQUAL "venvlauncher")
      set(_exe python)
      set(_kind _CONSOLE)
      set(_icon PY_ICON)
    else()
      set(_exe pythonw)
      set(_kind _WINDOWS)
      set(_icon PYW_ICON)
    endif()
    py_resource(_rc "${PY_SRC}/PC/pylauncher.rc" "${_v}${PY_DEBUG_EXT}.exe")
    add_executable(py_${_v} "${PY_SRC}/PC/venvlauncher.c" "${_rc}")
    set_target_properties(py_${_v} PROPERTIES
      OUTPUT_NAME "${_v}${PY_DEBUG_EXT}"
      RUNTIME_OUTPUT_DIRECTORY "${PY_OUT_BIN}/venv")
    target_compile_definitions(py_${_v} PRIVATE
      "$<$<COMPILE_LANGUAGE:C>:${_kind};EXENAME=L\"${_exe}${PY_DEBUG_EXT}.exe\">"
      "$<$<COMPILE_LANGUAGE:RC>:${_icon}>")
    py_resource_flags(py_${_v})
    # venvlauncher.c:288 passes a char ** where const char ** is expected.
    target_compile_options(py_${_v} PRIVATE -Wno-incompatible-pointer-types)
    target_link_options(py_${_v} PRIVATE -municode)
    if(_v STREQUAL "venvwlauncher")
      target_link_options(py_${_v} PRIVATE -mwindows)
    endif()
    target_link_libraries(py_${_v} PRIVATE pathcch)
    py_run_copy(static py_${_v})
    py_run_copy(shared py_${_v})
    list(APPEND PY_VENV_LAUNCHERS py_${_v})
  endforeach()
endif()

# ---- run directories --------------------------------------------------------
#
# <build>/run/<flavor> holds copies of the programs and an empty
# pybuilddir.txt: getpath.py then treats it as a build tree, and the
# standard library directory is the source tree's Lib (through VPATH), so
# tracebacks show source and Lib/test is importable.  Frozen modules still
# take precedence.
