# Generate pyconfig.h and the per-file configuration headers.
#
# String-valued macros (paths, git info) go in small headers under
# gen/cfg/ that are force-included, because escaping quotes and
# backslashes through compiler command lines is fragile.

set(PY_SIZEOF_VOID_P ${CMAKE_SIZEOF_VOID_P})
file(READ "${PY_SRC}/PC/pyconfig.h" PY_PC_PYCONFIG_H)
if(PY_DEBUG)
  set(PY_DEBUG_DEFINE "#define Py_DEBUG 1")
else()
  set(PY_DEBUG_DEFINE "/* release ABI: Py_DEBUG is not defined */")
endif()
if(PY_TARGET_XP)
  set(PY_XP_DEFINES [=[/* Windows XP */
#undef WITH_MIMALLOC
#define _PY_EMULATED_WIN_CV 1
#define _Py_NO_LCONV_W 1
#define _Py_TARGET_XP 1]=])
else()
  set(PY_XP_DEFINES "")
endif()
configure_file("${PY_W64}/templates/pyconfig.h.in" "${PY_GEN}/include/pyconfig.h" @ONLY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PY_SRC}/PC/pyconfig.h")

# Build-tree run directories (<build>/run/<flavor>) find the source tree
# through VPATH, which getpath.py joins to the executable's directory.
file(RELATIVE_PATH _py_vpath "${PY_RUN}/static" "${PY_SRC}")
if(_py_vpath STREQUAL "" OR IS_ABSOLUTE "${_py_vpath}")
  set(_py_vpath "${PY_SRC}")
endif()
string(REPLACE "/" "\\\\" PY_VPATH_C "${_py_vpath}")   # C string: \ is \\
unset(_py_vpath)

# Write a header only when its contents change, so that rebuilds stay minimal.
function(py_write_header path content)
  if(EXISTS "${path}")
    file(READ "${path}" _old)
    if(_old STREQUAL content)
      return()
    endif()
  endif()
  file(WRITE "${path}" "${content}")
endfunction()

py_write_header("${PY_GEN}/cfg/getpath_cfg.h" "\
/* Generated by PyConfig.cmake: macros for Modules/getpath.c */
#define PREFIX NULL
#define EXEC_PREFIX NULL
#define VERSION NULL
#define VPATH \"${PY_VPATH_C}\"
#define PYDEBUGEXT \"${PY_DEBUG_EXT}\"
#define PLATLIBDIR \"DLLs\"
")

py_write_header("${PY_GEN}/cfg/sysmodule_cfg.h" "\
/* Generated by PyConfig.cmake: macros for Python/sysmodule.c */
#define VPATH \"${PY_VPATH_C}\"
")

# How to build extension modules with this toolchain, for sysconfig (and
# so setuptools): Modules/_sysconfig.c.  The relative directories follow
# the install layout (Install.cmake), from bin/.  Extensions always link
# python.dll, the only image that loads them.
set(PY_INCLUDE_SUBDIR "python${PY_SHORT}${PY_DEBUG_EXT_PC}")
if(PY_ARCH STREQUAL "x64")
  set(_triplet x86_64-w64-mingw32)
else()
  set(_triplet i686-w64-mingw32)
endif()
if(PY_DEBUG)
  set(_cflags "-Og -g -Wall")
else()
  set(_cflags "-DNDEBUG -O2 -Wall")
endif()
# The Windows version extensions target (i686 mingw-w64 defaults to XP);
# the internal C API requires 10 (pyconfig.h).
string(APPEND _cflags " -D_WIN32_WINNT=${PY_WINNT_DEPS} -DWINVER=${PY_WINNT_DEPS}")
# -lpython<LDVERSION> must name the import library, python[N][_d].dll.a.
string(REGEX REPLACE "^python" "" _ldversion "${PY_BASENAME}${PY_DEBUG_EXT}")
if(PY_BUILD_SHARED)
  set(_shared 1)
else()
  set(_shared 0)
endif()
py_write_header("${PY_GEN}/cfg/sysconfig_cfg.h" "\
/* Generated by PyConfig.cmake: macros for Modules/_sysconfig.c */
#define PY_SYSCONFIG_BUILD_VARS 1
#define PY_SC_CC \"${_triplet}-gcc\"
#define PY_SC_CXX \"${_triplet}-g++\"
#define PY_SC_AR \"${_triplet}-ar\"
#define PY_SC_CFLAGS \"${_cflags}\"
#define PY_SC_LDFLAGS \"-shared -static-libgcc\"
#define PY_SC_LDCXXFLAGS \"-static-libstdc++\"
#define PY_SC_LDVERSION \"${_ldversion}\"
#define PY_SC_ENABLE_SHARED ${_shared}
#define PY_SC_INCLUDEDIR L\"../include/${PY_INCLUDE_SUBDIR}\"
#define PY_SC_LIBDIR L\"../lib\"
")
unset(_triplet)
unset(_cflags)
unset(_ldversion)
unset(_shared)

# Git information for Modules/getbuildinfo.c, refreshed on every build but
# rewritten only when it changes.
find_package(Git QUIET)
add_custom_target(py_gitinfo
  COMMAND "${CMAKE_COMMAND}"
          "-DGIT=${GIT_EXECUTABLE}"
          "-DSRC=${PY_SRC}"
          "-DOUT=${PY_GEN}/cfg/gitinfo.h"
          -P "${PY_W64}/cmake/scripts/gitinfo.cmake"
  BYPRODUCTS "${PY_GEN}/cfg/gitinfo.h"
  COMMENT "Getting build info from git"
  VERBATIM)
