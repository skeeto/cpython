# cmake -DGIT=<git> -DSRC=<source root> -DOUT=<header> -P gitinfo.cmake
#
# Writes GITVERSION, GITTAG and GITBRANCH for Modules/getbuildinfo.c, using
# the same git commands as PCbuild/pythoncore.vcxproj.  The header is only
# rewritten when its contents change.

set(_version "")
set(_tag "")
set(_branch "")
if(GIT AND EXISTS "${GIT}")
  execute_process(COMMAND "${GIT}" rev-parse --short HEAD
                  WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE _version
                  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND "${GIT}" describe --all --always --dirty
                  WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE _tag
                  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND "${GIT}" name-rev --name-only HEAD
                  WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE _branch
                  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif()
foreach(_v _version _tag _branch)
  string(REPLACE "\\" "\\\\" ${_v} "${${_v}}")
  string(REPLACE "\"" "\\\"" ${_v} "${${_v}}")
endforeach()

set(_content "/* Generated by gitinfo.cmake */
#define GITVERSION \"${_version}\"
#define GITTAG \"${_tag}\"
#define GITBRANCH \"${_branch}\"
")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
  if(_old STREQUAL _content)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${_content}")
