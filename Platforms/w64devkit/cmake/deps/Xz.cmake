    "${_xz}/liblzma/lzma"
    "${_xz}/liblzma/rangecoder"
    "${_xz}/liblzma/simple")
target_compile_definitions(pydep_lzma
  INTERFACE LZMA_API_STATIC
  PRIVATE   LZMA_API_STATIC HAVE_CONFIG_H _LIB)

# The same sources and configuration serve x64 and x86: the compiler's own
# __i386__/__x86_64__ selects the CLMUL helpers and size_t width.
# Only kernel32 (always linked) is used.
set_property(TARGET pydep_lzma PROPERTY PY_SYSTEM_LIBS "")

unset(_xz)
unset(_xz_gen)
unset(_xz_thread)
