# liblzma from xz, for _lzma.  Mirrors PCbuild/liblzma.vcxproj.
#
# Configuration comes from the tarball's windows/config.h (as in PCbuild),
# wrapped by a generated config.h that adds what GCC needs:
#   - HAVE_CPUID_H: crc_x86_clmul.h uses __get_cpuid() from GCC's <cpuid.h>
#     for the runtime CLMUL check instead of a raw inline-asm fallback.
#     windows/config.h enables HAVE_USABLE_CLMUL on x86 and x64 alike; GCC
#     compiles the CLMUL CRC functions with __attribute__((target)) and
#     dispatches at runtime, so no -m flags are needed and the generic
#     table code remains for CPUs without PCLMULQDQ.
#   - Threading: windows/config.h selects MYTHREAD_VISTA (condition
#     variables, InitOnce).  PY_TARGET_XP switches to MYTHREAD_WIN95, which
#     runs on Windows XP.
# HAVE_FUNC_ATTRIBUTE_CONSTRUCTOR is left undefined, as with MSVC: CRC
# dispatch resolves on the first call rather than in a static constructor.

set(_xz "${XZ_SRC}/src")
set(_xz_gen "${PY_GEN}/deps/lzma")

if(PY_TARGET_XP)
  set(_xz_thread "#undef MYTHREAD_VISTA\n#define MYTHREAD_WIN95 1")
else()
  set(_xz_thread "/* MYTHREAD_VISTA from windows/config.h */")
endif()
file(CONFIGURE OUTPUT "${_xz_gen}/config.h" CONTENT [=[
/* Generated by Platforms/w64devkit/cmake/deps/Xz.cmake */
#include "@XZ_SRC@/windows/config.h"
#define HAVE_CPUID_H 1
@_xz_thread@
]=] @ONLY)

