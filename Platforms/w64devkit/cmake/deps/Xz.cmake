add_library(pydep::lzma ALIAS pydep_lzma)
py_third_party_target(pydep_lzma)

target_include_directories(pydep_lzma
  INTERFACE
    "${_xz}/liblzma/api"
  PRIVATE
    "${_xz_gen}"              # config.h, ahead of anything in the tarball
    "${_xz}/liblzma/common"
    "${_xz}/common"
    "${_xz}/liblzma/api"
    "${_xz}/liblzma/check"
    "${_xz}/liblzma/delta"
