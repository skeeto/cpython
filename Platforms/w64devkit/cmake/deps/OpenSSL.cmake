# OpenSSL (libcrypto + libssl), from the pristine tarball plus the files
# that Configure and make would generate, committed under openssl/generated
# (see openssl/README.md; openssl/regen.sh refreshes them).  The source
# lists, include directories and defines come from Configure's own
# %unified_info for the mingw64 and mingw targets with no-asm no-shared
# no-module no-engine no-legacy no-quic.

set(OSSL_SOURCE_DIR "${OPENSSL_SRC}")
set(OSSL_GENERATED_DIR "${PY_W64}/openssl/generated")
include("${OSSL_GENERATED_DIR}/openssl-sources.cmake")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${OSSL_GENERATED_DIR}/openssl-sources.cmake" "${OSSL_GENERATED_DIR}/VERSION")

# The committed files must match the pin in Misc/externals.spdx.json.
file(STRINGS "${OSSL_GENERATED_DIR}/VERSION" _ossl_ver REGEX "^version=")
file(STRINGS "${OSSL_GENERATED_DIR}/VERSION" _ossl_sum REGEX "^sha256=")
string(REPLACE "version=" "" _ossl_ver "${_ossl_ver}")
string(REPLACE "sha256=" "" _ossl_sum "${_ossl_sum}")
string(TOLOWER "${PY_DEP_OPENSSL_SRC_SHA256}" _pin_sum)
if(NOT _ossl_ver STREQUAL PY_DEP_OPENSSL_SRC_VERSION OR NOT _ossl_sum STREQUAL _pin_sum)
  message(FATAL_ERROR
    "openssl/generated is for OpenSSL ${_ossl_ver} (${_ossl_sum}), but the SBOM pins "
    "${PY_DEP_OPENSSL_SRC_VERSION} (${_pin_sum}).  Run Platforms/w64devkit/openssl/regen.sh.")
endif()

if(PY_ARCH STREQUAL "x64")
  set(_a X86_64)
else()
  set(_a I686)
endif()

# OPENSSLDIR as python.org's builds have it (OpenSSL's VC-WIN64A and
# VC-WIN32 defaults): writable only by administrators.  Engines and
# providers are built in (no-engine no-module), so those directories are
# never searched.
if(PY_ARCH STREQUAL "x64")
  set(_ossl_pf [=[C:\\Program Files]=])
else()
  set(_ossl_pf [=[C:\\Program Files (x86)]=])
endif()
set(_ossl_cfg "${PY_GEN}/deps/openssl")
py_write_header("${_ossl_cfg}/ossl_dirs.h" "\
/* Generated by Platforms/w64devkit/cmake/deps/OpenSSL.cmake */
#define OPENSSLDIR \"${_ossl_pf}\\\\Common Files\\\\SSL\"
#define ENGINESDIR \"\"
#define MODULESDIR \"\"
")
unset(_ossl_pf)
# What util/mkbuildinf.pl writes, without a date (reproducible builds).
py_write_header("${_ossl_cfg}/buildinf/buildinf.h" "\
/* Generated by Platforms/w64devkit/cmake/deps/OpenSSL.cmake */
#define PLATFORM \"${OSSL_BUILDINF_PLATFORM_${_a}}\"
#define DATE \"built on: reproducible build, date unspecified\"
static const char compiler_flags[] = \"compiler: gcc ${CMAKE_C_COMPILER_VERSION}\";
")

set(_srcs)
foreach(_g IN LISTS OSSL_GROUPS)
  set(_s ${${_g}_SOURCES} ${${_g}_SOURCES_${_a}})
  list(APPEND _srcs ${_s})
  set_source_files_properties(${_s} PROPERTIES
    INCLUDE_DIRECTORIES "${${_g}_INCLUDES}"
    COMPILE_DEFINITIONS "${OSSL_DEFINES};${OSSL_DEFINES_${_a}};${${_g}_DEFINES}")
endforeach()
set_property(SOURCE ${OSSL_BUILDINF_SOURCES} APPEND PROPERTY
  INCLUDE_DIRECTORIES "${_ossl_cfg}/buildinf")

# Thread-exit cleanup for the statically linked libcrypto.
set(_tls "${PY_W64}/src/openssl_tls.c")
set_source_files_properties("${_tls}" PROPERTIES
  INCLUDE_DIRECTORIES "${OSSL_GENERATED_DIR}/include;${OSSL_SOURCE_DIR}/include")

add_library(pydep_openssl OBJECT ${_srcs} "${_tls}")
add_library(pydep::openssl ALIAS pydep_openssl)
py_third_party_target(pydep_openssl)
target_compile_options(pydep_openssl PRIVATE -include "${_ossl_cfg}/ossl_dirs.h")
target_include_directories(pydep_openssl INTERFACE
  "${OSSL_GENERATED_DIR}/include" "${OSSL_SOURCE_DIR}/include")
set_property(TARGET pydep_openssl PROPERTY PY_SYSTEM_LIBS
  ${OSSL_SYSTEM_LIBS} ${OSSL_SYSTEM_LIBS_${_a}} ${OSSL_SYSTEM_LIBS_IMPLICIT})
list(LENGTH _srcs _n)
message(STATUS "OpenSSL ${_ossl_ver}: ${_n} sources")
unset(_srcs)
unset(_tls)
unset(_a)
