# openlibm: correctly behaved double-precision math functions.
#
# The CRT's math functions are not good enough for CPython's tests or its
# users.  msvcrt.dll's tan, asin, acos, atan, sinh, cosh, tanh and log10,
# and the mingw-w64 static ones (sin, cos, exp, log, pow, fma, acosh, erf,
# ...), include several with errors of millions of ulps or wrong special
# cases: sin(1e22) has the wrong sign, fma mishandles infinities, x86 tan
# loses accuracy near pi/2.  openlibm (FreeBSD msun) is accurate to within
# an ulp everywhere.
#
# Only the double functions CPython calls are built, plus their helpers.
# The objects come before the CRT libraries on every link, so these
# definitions win; the CRT still supplies the exact functions (floor,
# ceil, modf, round, ...) that openlibm does not replace.  The prelinked
# libpython.a localizes them like any other dependency symbol, so an
# embedder's own libm is never affected.

set(_olm "${LIBM_SRC}")

# The closure of the replaced functions in src/: sin cos tan asin acos atan
# atan2 sinh cosh tanh asinh acosh atanh exp exp2 expm1 log log2 log10
# log1p pow cbrt erf erfc fmod fma hypot nextafter ldexp sincos (GCC turns
# sin(x) and cos(x) of the same argument into one sincos call).
set(_olm_names
  e_acos e_acosh e_asin e_atan2 e_atanh e_cosh e_exp e_fmod e_hypot e_log
  e_log10 e_log2 e_pow e_rem_pio2 e_sinh
  k_cos k_exp k_rem_pio2 k_sin k_tan
  s_asinh s_atan s_cbrt s_cimag s_copysign s_cos s_creal s_erf s_exp2
  s_expm1 s_fabs s_floor s_fma s_frexp s_ilogb s_isfinite s_isnormal
  s_log1p s_nextafter s_scalbn s_sin s_sincos s_tan s_tanh)
set(_olm_sources)
foreach(_n IN LISTS _olm_names)
  list(APPEND _olm_sources "${_olm}/src/${_n}.c")
endforeach()

# s_fma.c: when x*y and z cancel in the high part but the low part of x*y
# is not zero, the result is that low part scaled down, which may round to
# a zero whose sign must be kept; 0x1p-500*(1-0x1p-50) * 0x1p-500*(1+0x1p-50)
# - 0x1p-1000 must be -0.0, not 0.0 (test_math.test_fma_zero_result).  The
# early return is only right for an exact zero, and the general path below
# it already handles the rest.  The patched copy goes to the build tree.
set(_olm_fma "${PY_GEN}/deps/openlibm/s_fma.c")
file(READ "${_olm}/src/s_fma.c" _src)
set(_from "if (r.hi == 0.0) {")
string(FIND "${_src}" "${_from}" _at)
if(_at EQUAL -1)
  message(FATAL_ERROR "Openlibm.cmake: the s_fma.c patch no longer applies")
endif()
string(REPLACE "${_from}" "if (r.hi == 0.0 && xy.lo == 0.0) {" _src "${_src}")
set(_old "")
if(EXISTS "${_olm_fma}")
  file(READ "${_olm_fma}" _old)
endif()
if(NOT _old STREQUAL _src)
  file(WRITE "${_olm_fma}" "${_src}")
endif()
unset(_old)
list(TRANSFORM _olm_sources REPLACE "^.*/s_fma[.]c$" "${_olm_fma}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_olm}/src/s_fma.c")
unset(_src)
unset(_from)
unset(_at)

# openlibm_defs.h makes every function __declspec(dllexport) on Windows,
# which would export libm from python.dll.  Predefine its guard instead.
# sqrt is the one function left to the compiler: the SSE instruction is
# correctly rounded, while the x86 CRT's fsqrt runs at the x87's 64-bit
# precision and rounds twice.  openlibm_math.h is included first so that
# the macro does not touch its declaration.
py_write_header("${PY_GEN}/deps/olm_config.h" "\
/* Generated by Openlibm.cmake */
#define OPENLIBM_DEFS_H_
#define OLM_DLLEXPORT
#include <openlibm_math.h>
#define sqrt(x) __builtin_sqrt(x)
")

add_library(pydep_libm OBJECT ${_olm_sources})
add_library(pydep::libm ALIAS pydep_libm)
py_third_party_target(pydep_libm)
if(PY_ARCH STREQUAL "x64")
  set(_olm_arch amd64)
else()
  set(_olm_arch i387)
endif()
target_include_directories(pydep_libm PRIVATE
  "${_olm}" "${_olm}/include" "${_olm}/${_olm_arch}" "${_olm}/src")
target_compile_definitions(pydep_libm PRIVATE __BSD_VISIBLE)
# openlibm's own flags (CMakeLists.txt, Make.inc): strict IEEE semantics.
# -fwrapv: msun relies on signed overflow wrapping, as in scalbn's k+n
# (otherwise ldexp(1.0, INT_MAX) returns 0.0).
target_compile_options(pydep_libm PRIVATE
  -include "${PY_GEN}/deps/olm_config.h"
  -ffp-contract=off -fno-fast-math -fno-rounding-math -fno-math-errno
  -fno-builtin -fno-strict-aliasing -fwrapv)
set_property(TARGET pydep_libm PROPERTY PY_SYSTEM_LIBS "")
set_property(GLOBAL APPEND PROPERTY PY_DEP_TARGETS pydep_libm)

unset(_olm)
unset(_olm_arch)
unset(_olm_names)
unset(_olm_sources)
